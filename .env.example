# ============================================================
# LilyBot - Environment Variables Example
# ============================================================
# Salin file ini menjadi .env lalu isi dengan nilai yang sesuai.
# JANGAN PERNAH commit file .env ke git!

# Gemini API Key (untuk fitur AI Intent Gatekeeper)
GEMINI_API_KEY=

# Dashboard Authentication (wajib setelah hardening auth)
DASHBOARD_USER=admin
# Gunakan `npm run gen:hash -- "password-anda"` untuk generate hash password
DASHBOARD_PASS_HASH=

# Port server (opsional, default: 3000)
PORT=3000

# CORS Whitelist Origin (opsional)
ALLOWED_ORIGIN=

# Direktori Penyimpanan Data (default: ./data)
DATA_DIR=
